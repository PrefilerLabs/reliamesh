# Source archives include the public material needed to build and test the core.
include LICENSE NOTICE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include AGENTS.md requirements.lock Dockerfile compose.yaml
include .dockerignore .gitignore
recursive-include docs *.md
recursive-include tests *.py
recursive-include schemas *.json
include scripts/check_licenses.py scripts/verify_deployment.py
include infra/bootstrap.ps1 infra/deploy.ps1 infra/registry-cleanup.json
include examples/synthetic_regression.py
include sdk/python/pyproject.toml sdk/python/README.md sdk/python/LICENSE sdk/python/NOTICE
recursive-include sdk/python/src/reliamesh_sdk *.py

# Never include local credentials, operational state, or generated build outputs.
prune .git
prune .local
prune .venv
prune secrets
prune dist
prune build
prune sdk/python/dist
prune sdk/python/build
prune sdk/python/src/reliamesh_sdk.egg-info
global-exclude __pycache__ *.py[cod] *.db *.db-* .env .env.* *-credentials.json service-account*.json gha-creds-*.json
